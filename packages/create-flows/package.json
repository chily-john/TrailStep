{
  "name": "@trailstep/create-flows",
  "version": "0.3.0",
  "description": "Public reusable general-purpose TrailStep workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "keywords": [
    "trailstep-workflow"
  ],
  "trailstep": {
    "workflows": {
      "takeItAway": "./dist/index.js#takeItAway",
      "grillItAway": "./dist/index.js#grillItAway"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --loader .md=text",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@trailstep/authoring": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@trailstep/core": "workspace:*",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@trailstep/authoring": "^0.1.0"
  }
}

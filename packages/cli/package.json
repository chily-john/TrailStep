{
  "name": "@stepkit/cli",
  "version": "0.0.0",
  "description": "Command-line discovery and execution for StepKit workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/stepkit.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/stepkit/issues"
  },
  "homepage": "https://github.com/chily-john/stepkit#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "stepkit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@stepkit/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

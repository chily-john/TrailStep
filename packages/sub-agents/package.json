{
  "name": "@trailstep/sub-agents",
  "version": "0.1.0",
  "description": "Reusable TrailStep sub-agent workflows for delegated focused work.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "keywords": [
    "trailstep-workflow"
  ],
  "trailstep": {
    "workflows": {
      "delegate": "./dist/index.js#delegate",
      "delegateExplore": "./dist/index.js#delegateExplore",
      "delegateSimpleExplore": "./dist/index.js#delegateSimpleExplore",
      "delegateArchitectPlanner": "./dist/index.js#delegateArchitectPlanner",
      "delegateReview": "./dist/index.js#delegateReview",
      "delegateImplement": "./dist/index.js#delegateImplement",
      "delegateQuickImplementor": "./dist/index.js#delegateQuickImplementor",
      "delegateSmartImplementor": "./dist/index.js#delegateSmartImplementor",
      "delegateRelentlessDebugger": "./dist/index.js#delegateRelentlessDebugger",
      "delegateSchemaFormatter": "./dist/index.js#delegateSchemaFormatter",
      "delegateParallel": "./dist/index.js#delegateParallel"
    },
    "recommendedConfig": {
      "agents": {
        "orchestrator-planner": [
          {
            "provider": "pi",
            "model": "meta-llama/muse-spark-1.3",
            "thinking": "high"
          }
        ],
        "simple-explore": [
          {
            "provider": "pi",
            "model": "xiaomi/mimo-v2.6-flash",
            "thinking": "low"
          }
        ],
        "architect-planner": [
          {
            "provider": "pi",
            "model": "z.ai/glm-5.3-flash",
            "thinking": "high"
          }
        ],
        "quick-implementor": [
          {
            "provider": "pi",
            "model": "deepseek/deepseek-v4.1-flash",
            "thinking": "medium"
          }
        ],
        "smart-implementor": [
          {
            "provider": "pi",
            "model": "meta-llama/muse-spark-1.3",
            "thinking": "high"
          }
        ],
        "relentless-debugger": [
          {
            "provider": "pi",
            "model": "deepseek/deepseek-v4.1-flash",
            "thinking": "high"
          }
        ],
        "fixer": [
          {
            "ref": "relentless-debugger"
          }
        ],
        "schema-formatter": [
          {
            "provider": "pi",
            "model": "xiaomi/mimo-v2.6-flash",
            "thinking": "low"
          }
        ]
      },
      "workflows": {
        "delegate": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "smart-implementor"
              }
            ]
          }
        },
        "delegateExplore": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "simple-explore"
              }
            ]
          }
        },
        "delegateSimpleExplore": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "simple-explore"
              }
            ]
          }
        },
        "delegateArchitectPlanner": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "architect-planner"
              }
            ]
          }
        },
        "delegateReview": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "architect-planner"
              }
            ]
          }
        },
        "delegateImplement": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "smart-implementor"
              }
            ]
          }
        },
        "delegateQuickImplementor": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "quick-implementor"
              }
            ]
          }
        },
        "delegateSmartImplementor": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "smart-implementor"
              }
            ]
          }
        },
        "delegateRelentlessDebugger": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "relentless-debugger"
              }
            ]
          }
        },
        "delegateSchemaFormatter": {
          "agents": {
            "delegateAgent": [
              {
                "ref": "schema-formatter"
              }
            ]
          }
        }
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@trailstep/authoring": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@trailstep/core": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@trailstep/authoring": "^0.1.2"
  }
}

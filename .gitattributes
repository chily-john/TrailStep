# Normalize line endings to LF regardless of a contributor's local
# core.autocrlf setting. Without this, Windows checkouts with
# core.autocrlf=true rewrite tracked LF files to CRLF on disk, which biome
# (formatter.lineEnding defaults to "lf") then reports as formatting diffs.
* text=auto eol=lf
graphify-out/graph.json merge=graphify

{
  "name": "@trailstep/trailtest",
  "version": "0.1.0",
  "description": "Testing utilities for TrailStep workflows (trailtest).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src",
    "test:fast": "vitest run"
  },
  "dependencies": {
    "@trailstep/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "private": true
}

{
  "name": "@trailstep/cli",
  "version": "0.9.0",
  "description": "Command-line discovery and execution for TrailStep workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trailstep": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "trailstep-skill",
    "trailstep-authoring-skill"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/vitest-run.mjs",
    "test:fast": "node scripts/vitest-run.mjs --exclude src/e2e-continuation.test.ts",
    "test:e2e": "node scripts/vitest-run.mjs src/e2e-continuation.test.ts",
    "lint": "biome check src"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@trailstep/core": "workspace:*",
    "@trailstep/mcp": "workspace:*",
    "semver": "^7.8.5",
    "skills": "^1.7.4",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@trailstep/core": "^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

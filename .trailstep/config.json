  "providers": {
    "pi": {
      "source": {
        "type": "local-package",
        "packageName": "@trailstep/provider-pi",
        "spec": "./packages/provider-pi"
      },
      "manifest": {
        "schemaVersion": 1,
        "id": "pi",
        "displayName": "Pi",
        "working": {
          "supported": true,
          "command": "pi",
          "args": [
            "-p",
            "--mode",
            "json",
            "{{#model}}",
            "--model",
            "{{model}}",
            "{{/model}}",
            "{{#thinking}}",
            "--thinking",
            "{{thinking}}",
            "{{/thinking}}",
            "@{{promptFile}}"
          ],
          "followUp": {
            "supported": true,
            "sessionIdFlag": "--session-id",
            "resumeArgs": [
              "-p",
              "--mode",
              "json",
              "{{#model}}",
              "--model",
              "{{model}}",
              "{{/model}}",
              "{{#thinking}}",
              "--thinking",
              "{{thinking}}",
              "{{/thinking}}",
              "--session",
              "{{sessionId}}",
              "@{{promptFile}}"
            ]
          },
          "prompt": {
            "kind": "prompt-file",
            "reference": "at-prefixed-argument"
          },
          "output": {
            "style": "stdout-jsonl-transcript",
            "parsing": {
              "resultField": "message"
            }
          }
        },
        "interactive": {
          "supported": true,
          "command": "pi"
        },
        "model": {
          "supported": true
        },
        "thinking": {
          "supported": true,
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "hooks": {
          "extractOutput": {
            "supported": true,
            "source": "manual-recovery"
          }
        }
      }
    }
  },
  "storage": {
    "lifecycle": {
      "enabled": true,
      "compressAfter": "7d",
      "deleteAfter": "30d"
    }
  }
}

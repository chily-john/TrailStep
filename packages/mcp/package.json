{
  "name": "@trailstep/mcp",
  "version": "0.3.0",
  "description": "Model Context Protocol server for TrailStep workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:fast": "vitest run --exclude test/run-workflow-tool.test.ts",
    "test:e2e": "vitest run test/run-workflow-tool.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@trailstep/core": "workspace:*",
    "add-mcp": "^2.4.1"
  },
  "devDependencies": {
    "@trailstep/trailtest": "workspace:*",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "@trailstep/core": "*"
  }
}

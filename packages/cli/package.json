{
  "name": "@trailstep/cli",
  "version": "0.0.0",
  "description": "Command-line discovery and execution for TrailStep workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trailstep": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@trailstep/core": "workspace:*",
    "semver": "^7.8.5",
    "skills": "^1.5.19",
    "tsx": "^4.23.1"
  },
  "peerDependencies": {
    "@trailstep/core": "^0.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

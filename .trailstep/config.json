  },
  "workflows": {
    "project": {
      "grillItAway": "@trailstep/create-flows#grillItAway",
      "takeItAway": "@trailstep/create-flows#takeItAway"
    }
  },
  "workflowMetadata": {
    "project": {
      "grillItAway": {
        "kind": "package",
        "sourceType": "npm",
        "packageName": "@trailstep/create-flows",
        "requestedSpec": "@trailstep/create-flows@latest",
        "requestedRange": "latest",
        "installScope": "project",
        "targetRef": "@trailstep/create-flows#grillItAway",
        "workflowName": "grillItAway",
        "exportName": "grillItAway",
        "resolvedVersion": "0.1.0",
        "installOwnership": "trailstep-installed"
      },
      "takeItAway": {
        "kind": "package",
        "sourceType": "npm",
        "packageName": "@trailstep/create-flows",
        "requestedSpec": "@trailstep/create-flows@latest",
        "requestedRange": "latest",
        "installScope": "project",
        "targetRef": "@trailstep/create-flows#takeItAway",
        "workflowName": "takeItAway",
        "exportName": "takeItAway",
        "resolvedVersion": "0.1.0",
        "installOwnership": "trailstep-installed"
      }
    }
  },
  "providers": {
    "pi": {
      "source": {
        "type": "local-package",
        "packageName": "@trailstep/provider-pi",
        "spec": "./packages/provider-pi",
        "resolvedVersion": "0.1.0"
      },
      "manifest": {
        "schemaVersion": 1,
        "id": "pi",
        "displayName": "Pi",
        "working": {
          "supported": true,
          "command": "pi",
          "args": [
            "-p",
            "{{promptFile}}",
            "--output-file",
            "{{outputFile}}"
          ],
          "prompt": {
            "kind": "prompt-file"
          },
          "output": {
            "style": "provider-output-file"
          }
        },
        "interactive": {
          "supported": true,
          "command": "pi"
        },
        "model": {
          "supported": true
        },
        "thinking": {
          "supported": true,
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    }
  }
}

{
  "name": "@trailstep/mcp",
  "version": "0.2.2",
  "description": "TrailStep MCP server package.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "cd ../.. && vitest run packages/mcp/test/",
    "test:fast": "cd ../.. && vitest run packages/mcp/test/ --exclude **/run-workflow-tool.test.ts",
    "test:e2e": "cd ../.. && vitest run packages/mcp/test/run-workflow-tool.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@trailstep/core": "workspace:*",
    "add-mcp": "^2.4.1"
  },
  "devDependencies": {
    "@trailstep/trailtest": "workspace:*",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "@trailstep/core": "*"
  }
}

{
  "name": "@trailstep/create-flows",
  "version": "0.3.2",
  "description": "Public reusable general-purpose TrailStep workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chily-john/trailstep.git"
  },
  "bugs": {
    "url": "https://github.com/chily-john/trailstep/issues"
  },
  "homepage": "https://github.com/chily-john/trailstep#readme",
  "keywords": [
    "trailstep-workflow"
  ],
  "trailstep": {
    "workflows": {
      "takeItAway": "./dist/index.js#takeItAway",
      "grillItAway": "./dist/index.js#grillItAway"
    },
    "recommendedConfig": {
      "agents": {
        "orchestrator-planner": [
          {
            "provider": "pi",
            "model": "meta-llama/muse-spark-1.3",
            "thinking": "high"
          }
        ],
        "simple-explore": [
          {
            "provider": "pi",
            "model": "xiaomi/mimo-v2.6-flash",
            "thinking": "low"
          }
        ],
        "architect-planner": [
          {
            "provider": "pi",
            "model": "z.ai/glm-5.3-flash",
            "thinking": "high"
          }
        ],
        "quick-implementor": [
          {
            "provider": "pi",
            "model": "deepseek/deepseek-v4.1-flash",
            "thinking": "medium"
          }
        ],
        "smart-implementor": [
          {
            "provider": "pi",
            "model": "meta-llama/muse-spark-1.3",
            "thinking": "high"
          }
        ],
        "relentless-debugger": [
          {
            "provider": "pi",
            "model": "deepseek/deepseek-v4.1-flash",
            "thinking": "high"
          }
        ],
        "fixer": [
          {
            "ref": "relentless-debugger"
          }
        ],
        "schema-formatter": [
          {
            "provider": "pi",
            "model": "xiaomi/mimo-v2.6-flash",
            "thinking": "low"
          }
        ]
      },
      "workflows": {
        "take-it-away": {
          "agents": {
            "featureWriter": [
              {
                "ref": "orchestrator-planner"
              }
            ],
            "planner": [
              {
                "ref": "architect-planner"
              }
            ],
            "reviewer": [
              {
                "ref": "architect-planner"
              }
            ],
            "slicer": [
              {
                "ref": "architect-planner"
              }
            ],
            "storyExplorer": [
              {
                "ref": "simple-explore"
              }
            ],
            "testWriter": [
              {
                "ref": "quick-implementor"
              }
            ],
            "storyImplementer": [
              {
                "ref": "smart-implementor"
              }
            ],
            "storyDoctor": [
              {
                "ref": "relentless-debugger"
              }
            ],
            "validator": [
              {
                "ref": "simple-explore"
              }
            ],
            "storyReviewer": [
              {
                "ref": "architect-planner"
              }
            ]
          }
        },
        "grill-it-away": {
          "agents": {
            "grillingAgent": [
              {
                "ref": "orchestrator-planner"
              }
            ],
            "featureWriter": [
              {
                "ref": "orchestrator-planner"
              }
            ],
            "planner": [
              {
                "ref": "architect-planner"
              }
            ],
            "reviewer": [
              {
                "ref": "architect-planner"
              }
            ],
            "slicer": [
              {
                "ref": "architect-planner"
              }
            ],
            "storyExplorer": [
              {
                "ref": "simple-explore"
              }
            ],
            "testWriter": [
              {
                "ref": "quick-implementor"
              }
            ],
            "storyImplementer": [
              {
                "ref": "smart-implementor"
              }
            ],
            "storyDoctor": [
              {
                "ref": "relentless-debugger"
              }
            ],
            "validator": [
              {
                "ref": "simple-explore"
              }
            ],
            "storyReviewer": [
              {
                "ref": "architect-planner"
              }
            ]
          }
        }
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --loader .md=text",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@trailstep/authoring": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@trailstep/core": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@trailstep/authoring": "^0.1.2"
  }
}

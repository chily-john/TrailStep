{
  "name": "trailstep",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "arch:check": "node factory/arch/dist/cli.js",
    "arch:explain": "node factory/arch/dist/cli.js --explain",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "version": "changeset version",
    "publish:prepare": "pnpm build && changeset version",
    "check:public-packages": "node scripts/check-public-package-metadata.ts",
    "check:lockfile-sync": "node scripts/check-lockfile-sync.ts",
    "pack:public:dry-run": "node scripts/pack-public-packages.ts",
    "sandbox": "node scripts/sandbox.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.1",
    "@trailstep/create-flows": "workspace:*",
    "@trailstep/sub-agents": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "turbo": "^2.10.10",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@trailstep/provider-pi": "workspace:*"
  }
}

{
  "_comment": "TrailStep OpenViking example (OpenRouter + Qwen). Copy to ~/.openviking/ov.conf and replace your-openrouter-api-key. Never commit a filled-in ov.conf.",
  "storage": {
    "workspace": "./data",
    "vectordb": {
      "name": "context",
      "backend": "local"
    },
    "agfs": {
      "backend": "local"
    }
  },
  "embedding": {
    "dense": {
      "provider": "openai",
      "api_base": "https://openrouter.ai/api/v1",
      "api_key": "your-openrouter-api-key",
      "model": "qwen/qwen3-embedding-8b",
      "dimension": 4096,
      "extra_body": {
        "provider": {
          "sort": "latency"
        }
      }
    }
  },
  "vlm": {
    "provider": "openai",
    "api_base": "https://openrouter.ai/api/v1",
    "api_key": "your-openrouter-api-key",
    "model": "qwen/qwen2.5-vl-72b-instruct",
    "extra_headers": {
      "HTTP-Referer": "https://github.com/chily-john/trailstep",
      "X-Title": "TrailStep OpenViking"
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 1933
  }
}
